# Development Postgres / Neon
DATABASE_URL=

# Vercel Cron / internal scheduled ingestion
# Required before enabling any production cron. Vercel sends it as
# Authorization: Bearer <CRON_SECRET> to configured cron routes.
CRON_SECRET=

# Dirección Meteorológica de Chile (DMC)
DMC_USER=
DMC_TOKEN=
DMC_DEFAULT_STATION=330021

# Observatorio Logístico / MTT
OBSERVATORIO_LOGISTICO_API_KEY=

# Biblioteca del Congreso Nacional / LeyChile v1
LEYCHILE_API_KEY=

# Banco Central de Chile / BDE REST API
BCCH_BDE_TOKEN=

# Coordinador Eléctrico Nacional / SIP
CEN_SIP_API_KEY=

# Comisión Nacional de Energía / API CNE
# Required for the protected liquid-fuel price/sales endpoints.
CNE_API_TOKEN=

# Dirección ChileCompra / Mercado Público
CHILECOMPRA_API_TICKET=
